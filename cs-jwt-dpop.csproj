<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>cs-jwt-dpop</AssemblyName>
    <RootNamespace>jwt_dpop</RootNamespace>
    <Description>JWT DPoP (Demonstration of Proof of Possession) token</Description>
    <Authors>Mahmoud ElNemer</Authors>
    <PackageProjectUrl>https://github.com/ElNeMeR70/cs-jwt-dpop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ElNeMeR70/cs-jwt-dpop</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
